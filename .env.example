# ==============================================================================
# Singularity Bridge — Environment Configuration
# ==============================================================================

# Discord Bot Token (Obtained from Discord Developer Portal -> Bot -> Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Single Authorized Discord User ID (Snowflake).
# Any messages from any other user or bot will be immediately dropped.
ALLOWED_USER_ID=123456789012345678

# Optional: Restrict bot execution strictly to channels/threads inside this Category ID
ALLOWED_CATEGORY_ID=1553802311111811202

# Mapping of Discord Channel IDs or Thread Parent IDs to absolute local workspace paths.
# Format: JSON string representing an object with string keys and string paths.
WORKSPACE_MAPPINGS={"123456789012345678":"/workspace/project-alpha","987654321098765432":"/workspace/project-beta"}

# The command prefix/binary to invoke inside the resolved workspace.
# The user's prompt (with conversational history) will be provided as input.
# Default: antigravity run
COMMAND_PREFIX_BIN=antigravity run

# Optional: Subprocess execution timeout in milliseconds (Default: 600000 = 10 minutes)
EXECUTION_TIMEOUT_MS=600000

# Optional: Maximum buffer size for stdout/stderr in bytes (Default: 15728640 = 15MB)
MAX_BUFFER_BYTES=15728640

# Optional: Discord typing indicator heartbeat interval in milliseconds (Default: 7000 = 7 seconds)
TYPING_INTERVAL_MS=7000
